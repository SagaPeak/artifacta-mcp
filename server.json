{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.artifacta/mcp",
  "description": "Artifact store for AI agents — persist, list, hand off run outputs with session metadata and dedup.",
  "repository": {
    "url": "https://github.com/SagaPeak/artifacta-mcp",
    "source": "github"
  },
  "version": "1.0.3",
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://mcp.artifacta.io/mcp"
    }
  ],
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "@artifacta-mcp/mcp",
      "version": "1.0.2",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "ARTIFACTA_API_KEY",
          "description": "Artifacta API key (ak_live_...) from https://app.artifacta.io/dashboard/keys",
          "isRequired": true,
          "isSecret": true,
          "format": "string"
        }
      ]
    },
    {
      "registryType": "pypi",
      "registryBaseUrl": "https://pypi.org",
      "identifier": "artifacta-mcp",
      "version": "1.0.2",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "ARTIFACTA_API_KEY",
          "description": "Artifacta API key (ak_live_...) from https://app.artifacta.io/dashboard/keys",
          "isRequired": true,
          "isSecret": true,
          "format": "string"
        }
      ]
    }
  ]
}
